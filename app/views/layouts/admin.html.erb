<!DOCTYPE html>
<html class="scroll-p-6 scroll-smooth focus:scroll-auto">
  <head>
    <title>Admin Panel</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <link rel="manifest" crossorigin="use-credentials" href="/manifest.json" />
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "lexxy", "data-turbo-track": "reload" %>
    <%= favicon_link_tag asset_path('favicon.png') %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-gray-50">
    <main class="min-h-screen p-4">
      <div class="max-w-screen-lg w-full mx-auto p-4 bg-white shadow-md rounded-lg flex flex-col gap-4">
        <nav class="flex items-baseline text-sm gap-2 border-b border-gray-200 pb-3">
          <p><span class="font-bold text-gray-900"><%= current_user.name %></span> <%= link_to "(Logout?)", guests_sign_out_path(current_user), class: "text-gray-600 hover:underline" %></p>
          <h5 class="ml-1 font-bold uppercase text-xs">Quick links:</h5>
          <div class="flex gap-2">
            <%= link_to "Guests", admin_root_path, class: "underline hover:decoration-dotted" %>
            <%= link_to "Parties", admin_parties_path, class: "underline hover:decoration-dotted" %>
            <%= link_to "Emails", admin_mailings_path, class: "underline hover:decoration-dotted" %>
            <%= link_to "Groups", admin_groups_path, class: "underline hover:decoration-dotted" %>
            <%= link_to "Pages", admin_pages_path, class: "underline hover:decoration-dotted" %>
            <%= link_to "Locations", admin_locations_path, class: "underline hover:decoration-dotted" %>
          </div>
          <div class="ml-auto">
            <%= render "shared/flash" %>
          </div>
        </nav>
        <%= yield %>
      </div>
    </main>
  </body>
</html>
