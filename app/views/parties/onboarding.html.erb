<div class="min-h-screen bg-gray-50 py-12 px-4">
  <div class="max-w-4xl mx-auto space-y-8">
    <% if @party.guests.include? current_user # don't confuse admins %>
      <section class="card">
        <div class="text-center mb-6">
          <h2>Meal Selection</h2>
          <p class="text-gray-600">Please select your meal preference:</p>
        </div>
        <%= form_for current_user, data: {
            controller: "form",
            action: "input->form#submit"
          } do |f| %>
          <div class="grid md:grid-cols-3 gap-4">
            <%= f.label :food_preference_vegetarian, class: "block text-center cursor-pointer transition-all hover:shadow-lg rounded-lg p-4 border-2 has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50" do %>
              <%= f.radio_button :food_preference, 'vegetarian', class: "sr-only peer" %>
              <%= image_tag('food/vegetarian.jpg', alt: 'Vegetarian', title: 'Vegetarian', class: "rounded-lg border border-gray-200 w-full h-48 object-cover mb-2" ) %>
              <span class="font-medium text-lg">Vegetarian</span>
            <% end %>
            <%= f.label :food_preference_duck, class: "block text-center cursor-pointer transition-all hover:shadow-lg rounded-lg p-4 border-2 has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50" do %>
              <%= f.radio_button :food_preference, 'duck', class: "sr-only peer" %>
              <%= image_tag('food/duck.jpg', alt: 'Duck', title: 'Duck', class: "rounded-lg border border-gray-200 w-full h-48 object-cover mb-2" ) %>
              <span class="font-medium text-lg">Duck</span>
            <% end %>
            <%= f.label :food_preference_salmon, class: "block text-center cursor-pointer transition-all hover:shadow-lg rounded-lg p-4 border-2 has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50" do %>
              <%= f.radio_button :food_preference, 'salmon', class: "sr-only peer" %>
              <%= image_tag('food/salmon.jpg', alt: 'Salmon', title: 'Salmon', class: "rounded-lg border border-gray-200 w-full h-48 object-cover mb-2" ) %>
              <span class="font-medium text-lg">Salmon</span>
            <% end %>
          </div>
        <% end %>
      </section>
    <% end %>

    <section class="card">
      <div class="text-center mb-6">
        <h2>Your Party</h2>
        <p class="text-gray-600">Add any additional guests who will be attending with you:</p>
      </div>

      <h3 class="text-lg font-semibold border-b border-gray-200 pb-2 mb-4">Additional Guests</h3>
      <%= render @party, guests: @additional_guests %>

      <%= form_for @party do |f| %>
        <div class="field">
          <%= f.label :notes, "Additional Notes" %>
          <%= f.text_area :notes, rows: 6, placeholder: "Please let us know about any dietary restrictions, allergies, or special accommodations." %>
        </div>
        <% if @party.errors.any? %>
          <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded-md mt-4">
            <%= @party.errors.full_messages.to_sentence %>
          </div>
        <% end %>
        <div class="text-right mt-6">
          <%= f.submit "Submit RSVP", class: "btn primary text-lg" %>
        </div>
      <% end %>
    </section>
  </div>
</div>
