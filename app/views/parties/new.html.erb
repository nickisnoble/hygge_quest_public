<div class="min-h-screen bg-gray-50 py-12 px-4">
  <div class="max-w-2xl mx-auto space-y-8">
    <section class="text-center card">
      <div class="space-y-4">
        <h1>You're Invited</h1>
        <p class="text-xl text-gray-600">Join us as we celebrate</p>
        <h2 class="text-3xl">Marnie Williams &amp; Nick Noble</h2>
        <p class="text-lg text-gray-600">April 28th, 2024</p>
      </div>
    </section>

    <section class="card">
      <%= form_for @party, url: party_path do |f| %>
        <div class="space-y-6">
          <% if @party.errors.any? %>
            <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded-md">
              <h4 class="font-semibold mb-2"><%= pluralize(@party.errors.count, "error") %> occurred:</h4>
              <ul class="list-disc list-inside">
                <% @party.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="text-center">
            <%= f.label :rsvp, "Will you be able to attend?", class: "block text-xl font-semibold mb-4" %>
            <div class="inline-flex flex-col gap-2">
              <%= f.label :rsvp_true, class: "flex items-center gap-2 cursor-pointer" do %>
                <%= f.radio_button :rsvp, true, required: true, class: "h-4 w-4" %>
                <span class="text-lg">Yes, I'll be there</span>
              <% end %>
              <%= f.label :rsvp_false, class: "flex items-center gap-2 cursor-pointer" do %>
                <%= f.radio_button :rsvp, false, required: true, class: "h-4 w-4" %>
                <span class="text-lg">Sorry, I can't make it</span>
              <% end %>
            </div>
          </div>

          <%= f.fields_for :guests do |g| %>
            <% if g.object.errors.any? %>
              <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded-md">
                <h4 class="font-semibold mb-2"><%= pluralize(g.object.errors.count, "error") %> occurred:</h4>
                <ul class="list-disc list-inside">
                  <% g.object.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="space-y-4">
              <div class="field">
                <%= g.label :name, "Your name" %>
                <%= g.text_field :name, required: true, placeholder: "First and Last Name" %>
              </div>
              <div class="field">
                <%= g.label :email, "Your email" %>
                <%= g.email_field :email, required: true, placeholder: "email@example.com" %>
              </div>
            </div>

            <p class="text-sm text-gray-600 italic">You'll be able to add additional guests on the next page.</p>
          <% end %>

          <div class="text-center pt-4">
            <%= f.submit "Continue", class: "btn primary" %>
          </div>
        </div>
      <% end %>
    </section>
  </div>
</div>
