<%= turbo_frame_tag dom_id(@guest), class: "" do %>
  <%= form_with model: [:admin, @guest], class: "contents *:self-end" do |f| %>
    <div class="field  p-1">
      <%= f.text_field :name, required: true %>
    </div>
    <div class="field  p-1">
      <%= f.collection_select :party_id, Party.all, :id, :name, { class: "block w-full" } %>
    </div>
    <div class="field  p-1">
      <% food_options = [['Foraged (V)', 'vegetarian'], ['Fowl (Duck)', 'duck'], ['Fish (Salmon)', 'salmon']] %>
      <% food_options.prepend(["Child's Meal", 'child']) if @guest.under_13? %>
      <%= f.select :food_preference, food_options, { prompt: "Wants to eat..." }, { class: "block w-full" } %>
    </div>
    <div class="field  p-1">
      <%= f.collection_select :group_id, Group.all, :id, :name, { include_blank: 'Select Group' }, { class: "block w-full" } %>
    </div>
    <div class="field  p-1">
      <%= f.text_field :notes %>
    </div>
    <div class="actions flex justify-end">
      <%= f.submit class: "btn primary" %>
    </div>
  <% end %>
<% end %>