<div class="grid grid-cols-2">

  <div class="prose w-1/3 prose-emerald">
    <table>
      <thead class="uppercase font-bold text-xs">
        <tr>
          <th>Meal</th>
          <th>Count</th>
        </tr>
      </thead>
      <tbody>
        <% @attending.group_by(&:food_preference).each do |meal, guests| %>
          <tr>
            <td class="whitespace-nowrap"><%= guests.first.meal %></td>
            <td><%= guests.count %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="prose w-1/3 prose-emerald">
    <table>
      <thead class="uppercase font-bold text-xs">
        <tr>
          <th>Group</th>
          <th>Count</th>
        </tr>
      </thead>
      <tbody>
        <% @attending.group_by(&:group).each do |group, guests| %>
          <tr>
            <td><%= group&.name %></td>
            <td><%= guests.count %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>



</div>
