<div class="space-y-6">
  <div class="flex justify-between items-center">
    <h1>Groups</h1>
    <%= link_to "New Group", new_admin_group_path, class: "btn" %>
  </div>

  <div class="card">
    <table class="w-full">
      <thead>
        <tr>
          <th class="text-left">Name</th>
          <th class="text-left">Description</th>
          <th class="text-left">Members</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @groups.each do |group| %>
          <tr>
            <td><%= group.name %></td>
            <td><%= truncate(group.description, length: 50) %></td>
            <td><%= group.members.count %></td>
            <td class="text-right space-x-2">
              <%= link_to "Edit", edit_admin_group_path(group), class: "text-blue-600 hover:underline" %>
              <%= button_to "Delete", admin_group_path(group), method: :delete,
                  data: { confirm: "Are you sure? This will not delete guests in this group." },
                  class: "text-red-600 hover:underline inline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
