<main class="min-h-screen bg-gray-100 flex items-center justify-center">
  <nav class="bg-white rounded-lg shadow-lg p-8 max-w-md w-full mx-4">
    <h1 class="text-3xl font-bold mb-6 text-center text-gray-900">Wedding</h1>
    <div class="space-y-3">
      <% if current_user %>
        <p class="text-gray-600 mb-4">Welcome back, <%= current_user.name %>!</p>

        <%= link_to "Admin Dashboard", admin_root_path, class: "block w-full text-center btn primary" if current_user&.admin? %>

        <% if current_user.party.rsvp?  %>
          <%= link_to "Your RSVP", party_path, class: "block w-full text-center btn" %>
          <%= link_to "Locations", map_path, class: "block w-full text-center btn", data: { turbo: false } %>
        <% end %>
      <% else %>
        <%= link_to "RSVP", new_party_path, class: "block w-full text-center btn primary" %>
      <% end %>

      <%= link_to "Registry", page_path("registry"), class: "block w-full text-center btn" %>

      <div class="pt-4 border-t border-gray-200">
        <%= auth_link %>
      </div>
    </div>
  </nav>
</main>
